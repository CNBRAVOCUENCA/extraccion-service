# Configuración del microservicio de extracción (Twelve-Factor).
# Copiar a .env y ajustar. Ninguna de estas variables es secreta.

DEBUG=false

# --- Flujo asíncrono (Saga) ---
DOCUMENTOS_SERVICE_URL=http://localhost:8001
# Debe coincidir con EXTRACTION_SERVICE_API_KEY en documentos-service.
DOCUMENTOS_SERVICE_API_KEY=
API_V1_PREFIX=/api/v1

# --- Endpoint síncrono POST /extract (test de carga) ---
# Backend: pypdf (baseline) o pymupdf (rápido, recomendado)
EXTRACTOR_BACKEND=pymupdf
EXTRACT_WORKERS=1
MAX_INFLIGHT=16

# --- Descubrimiento opcional en Consul (vacío desactiva el registro) ---
CONSUL_HTTP_ADDR=
CONSUL_HTTP_TOKEN=
# Si se omite, el nombre se toma de APP_NAME; el puerto predeterminado es 8000.
CONSUL_SERVICE_NAME=
CONSUL_SERVICE_PORT=8000
# Tags libres; pueden incluir etiquetas usadas por Traefik, separadas por coma.
CONSUL_SERVICE_TAGS=
# Sobrescribir si la IP seleccionada automáticamente no es accesible por Consul.
CONSUL_SERVICE_ADDRESS=
# --- Caché Redis ---
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600
