# Configuración del microservicio de extracción (Twelve-Factor).
# Copiar a .env y ajustar. Ninguna de estas variables es secreta.

DEBUG=false

# --- Flujo asíncrono (Saga) ---
DOCUMENTOS_SERVICE_URL=http://localhost:8001
API_V1_PREFIX=/api/v1

# --- Endpoint síncrono POST /extract (test de carga) ---
# Backend: pypdf (baseline) o pymupdf (rápido, recomendado)
EXTRACTOR_BACKEND=pymupdf
EXTRACT_WORKERS=1
MAX_INFLIGHT=16

# --- Caché Redis ---
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600
